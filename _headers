# Keep the hosting aliases out of search; only the custom domain is canonical.
https://mediumrarecode.pages.dev/*
  X-Robots-Tag: noindex

https://:version.mediumrarecode.pages.dev/*
  X-Robots-Tag: noindex

/song.html
  X-Robots-Tag: noindex, follow

/single.html
  X-Robots-Tag: noindex, follow

/404.html
  X-Robots-Tag: noindex, follow

/assets/covers/optimized/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/optimized/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/logos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/favicon-48-2026.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/apple-touch-icon-2026.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/medium-rare-code-logo-2026.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/medium-rare-code-background-2026.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/styles.css
  Cache-Control: public, max-age=86400, must-revalidate

/app.js
  Cache-Control: public, max-age=86400, must-revalidate

/site-data.js
  Cache-Control: public, max-age=86400, must-revalidate

/artist.json
  Content-Type: application/ld+json; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
